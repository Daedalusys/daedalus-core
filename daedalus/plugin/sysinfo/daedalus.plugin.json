{
  "id": "daedalus.sysinfo",
  "name": "Daedalus System Information",
  "version": "0.1.0",
  "type": "capability",
  "runtime": "native",
  "executable": "bin/daedalus-sysinfo",
  "tools": ["os_release", "hardware_info", "network_status"],
  "permissions": {
    "read": ["/etc/os-release", "/usr/lib/os-release", "/proc", "/sys"],
    "write": [],
    "run": ["/usr/bin/ip"]
  }
}
