[Unit]
Description=Daedalus OS Deno Shell MCP Sandbox Profile

[Service]
Type=simple
# shell_server.ts 在模块顶层读取环境变量（ALLOW_COMMANDS / DAEDALUS_AUDIT_LOG_PATH），
# 必须授予 --allow-env，否则 Deno 在加载阶段抛出 NotCapable，服务立即退出。
ExecStart=/usr/local/bin/deno run --allow-run=/usr/bin/df,/usr/bin/ls,/usr/bin/cat,/usr/bin/pwd,/usr/bin/uname,/usr/bin/free,/usr/bin/ps,/usr/bin/uptime,/usr/bin/whoami,/usr/bin/ip,/usr/bin/arch,/usr/bin/hostname,/usr/bin/date,/usr/bin/ping,/usr/bin/systemctl --allow-read=/home,/var/log,/tmp,/proc,/sys,/etc/os-release,/usr/lib/os-release,/etc/fedora-release,/etc/almalinux-release --allow-write=/var/log/daedalus --allow-env /opt/daedalus/deno/shell_server.ts
DynamicUser=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=daedalus
NoNewPrivileges=yes
CPUQuota=50%
MemoryMax=256M
IOWeight=100
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
