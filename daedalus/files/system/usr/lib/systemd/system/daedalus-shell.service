[Unit]
Description=Daedalus OS Shell MCP Sandbox Profile

[Service]
Type=simple
ExecStart=/opt/daedalus/venv/bin/python /opt/daedalus/servers/shell_server.py
DynamicUser=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=daedalus
NoNewPrivileges=yes
CPUQuota=50%
MemoryMax=256M
IOWeight=100
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
