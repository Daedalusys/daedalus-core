{
  "id": "daedalus.blueprint",
  "name": "Daedalus Blueprint",
  "version": "0.1.0",
  "type": "capability",
  "runtime": "native",
  "executable": "bin/daedalus-blueprint",
  "permissions": {
    "read": [
      "/etc/nginx/conf.d",
      "/etc/haproxy",
      "/etc/postgresql",
      "/etc/redis"
    ],
    "write": [
      "/etc/nginx/conf.d",
      "/etc/haproxy",
      "/etc/postgresql",
      "/etc/redis"
    ],
    "run": [
      "/usr/bin/nginx",
      "/usr/bin/haproxy",
      "/usr/bin/psql",
      "/usr/bin/redis-cli",
      "/usr/bin/systemctl"
    ]
  },
  "tools": [
    "blueprint_list",
    "blueprint_inspect",
    "blueprint_render",
    "blueprint_apply",
    "blueprint_status",
    "blueprint_remove"
  ],
  "checksums": {
    "bin/daedalus-blueprint": "sha256:937ab80050820c0badfc3ed519b02192aa9afee1594d3a438a0667bd6a365112",
