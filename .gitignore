# daedalus-core 模块级忽略项。
#
# 蓝图嵌入数据副本(blueprint-embed rsync 产物)不在本仓——能力源码与
# 其忽略规则都在兄弟仓 daedalus-plugins/(见该仓 .gitignore)。

# go.work 本地 dev 桥(3 仓平级 clone 后生成;不入库;模板 go.work.example 入库)
go.work
go.work.sum

# 构建产物(just go-build / just plugin-pack 落位的二进制与插件 zip,不入库)
bin/

# 镜像安装态二进制不入库(见 AGENTS「镜像安装态策略」)。插件侧 files/system/opt/
# daedalus/plugins/*/bin/ 已被上方 `bin/` 覆盖;`bin/` 同样会连带忽略整个
# files/system/usr/local/bin/ 目录,故先解禁目录,再按 `daedalus-*` 排除 plugin-pack
# 现构产物 —— 手写的 `daedalus` CLI wrapper 无后缀、是源码,必须入库。
!files/system/usr/local/bin/
files/system/usr/local/bin/daedalus-*

# copilot 安装态是 just copilot-plugin (pack-copilot-plugin.sh) 的构建产物,
# 从 plugin/copilot/ 源码再生。CI 调 just copilot-plugin 重新生成 + 幂等验证
# (跑两次 sha256 一致 → 产物可重现)。本机开发者跑 just copilot-plugin 后
# 无需 commit 安装态,绕过 12-factor 「构建产物不入库」违背。
#
# 为何只忽略 daedalus.copilot 一个:它是仓内唯一靠 pack 脚本生成的安装态;其它
# 插件(daedalus.fs / .pkg / .sysinfo 等)的 files/system/opt/.../ 是 sync 进来
# 的源码本体,不在这条规则覆盖范围(若改这些源码需要走 plugin-pack + fetch-plugins
# 流水线,不是本地 just copilot-plugin)。
files/system/opt/daedalus/plugins/daedalus.copilot/

# OhMyOpenCode 编排状态(不入库)
.omo/

# superpowers 设计稿 / 实施计划 / 自检材料(本地协作产物,不入库)
docs/superpowers/
