[Unit]
Description=Daedalus Journal MCP Sandbox Profile
# 日志读取依赖 journald 已就绪(After 属 [Unit] 指令;[Service] 段内的 After
# 会被 systemd 忽略,不得放错段)。仅排序,不构成硬依赖(Requires/Wants 不写)。
After=systemd-journald.service

[Service]
Type=simple
# ExecStart 内容由插件 manifest(daedalus.journal)派生:构建期 76-daedalus-plugin-gen.sh
# 调 daedalus-host render-unit 渲染并自校验一致性(计划 todo 9,决策 16/22);手工漂移将导致构建失败。
ExecStart=/opt/daedalus/plugins/daedalus.journal/bin/daedalus-journal
DynamicUser=yes
# 生产 /var/log/journal/<machine-id>/*.journal 为 0640/0660 root:systemd-journal,
# DynamicUser 默认不属于任何组则读不到持久日志(只落回内存 journal 或空结果)。
# 显式加入 systemd-journal 补充组换取读权限;manifest read 权限无法赋予组身份。
SupplementaryGroups=systemd-journal
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=daedalus
NoNewPrivileges=yes
CPUQuota=50%
MemoryMax=256M
IOWeight=100
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
