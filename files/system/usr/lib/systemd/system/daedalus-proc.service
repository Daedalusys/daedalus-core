[Unit]
Description=Daedalus Process Reconnaissance MCP Sandbox Profile

[Service]
Type=simple
# ExecStart 内容由插件 manifest(daedalus.proc)派生:构建期 76-daedalus-plugin-gen.sh
# 调 daedalus-host render-unit 渲染并自校验一致性;手工漂移将导致构建失败。
# 策略消费约定:只读观测面,不注入 Environment=ALLOW_COMMANDS(REPLACE 覆盖语义)。
#
# ProtectProc=no 是**有意为之**:本服务的本职是读 /proc 下**他人**进程
# (proc_list / proc_tree / proc_fds / proc_cgroup / proc_listen)。DynamicUser=yes
# 使进程以非 root 身份运行,而 ProtectProc 的默认值对非 root 单元等价于 hidden ——
# 那会让本服务在 /proc 里只看得见自己,直接废掉除「看自己」以外的全部工具能力。
# 显式 no = 完整 /proc 可见。切勿改成 ProtectProc=invisible(连自己的进程都会隐藏)。
ExecStart=/opt/daedalus/plugins/daedalus.proc/bin/daedalus-proc
DynamicUser=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=no
StateDirectory=daedalus
NoNewPrivileges=yes
CPUQuota=50%
MemoryMax=256M
IOWeight=100
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
