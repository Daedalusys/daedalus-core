[Unit]
Description=Daedalus 巡检(一轮,oneshot;只读)
After=network-online.target
Wants=network-online.target
# 不设 DynamicUser:巡检要读 fleet 客户端的 mTLS 私钥(仅 root 可读),并以 root 的
# 客户端配置取模型凭据。整条链路只做只读调用,不写任何节点状态。

[Service]
Type=oneshot
# 节点名由运维写进 /etc/daedalus/patrol.env(DAEDALUS_PATROL_NODE)。未配置时
# ${DAEDALUS_PATROL_NODE} 展开成空串,CLI 按用法错误退出 —— 宁可不跑,也不猜节点。
# fleet 凭证路径(DAEDALUS_FLEET_CLIENT_CERT / _KEY / _CA)同样写在这份 env 文件里;
# 证书权限决定这一轮能不能连上节点(见 files/system/etc/daedalus/patrol.toml 注释)。
EnvironmentFile=-/etc/daedalus/patrol.env
ExecStart=/usr/local/bin/daedalus-patrol run --node ${DAEDALUS_PATROL_NODE}

# 轮次目录与跨轮状态都在这里;运行时给 AI 客户端一个可写的 HOME(它要写会话缓存),
# 但模型配置从 root 的 opencode 配置只读挂进来 —— 密钥不进轮次目录、不进单元文件。
#
# daedalus 一并列出:fleet 根目录(/var/lib/daedalus/fleet)在 strict 沙箱里必须可写 ——
# SDK 的目录解析靠写哨兵文件判定可用,不可写会静默回退到 $HOME 下的空注册表,
# 现场表现为「所有节点都未注册」。
StateDirectory=daedalus-patrol daedalus
Environment=HOME=/var/lib/daedalus-patrol/home
ExecStartPre=/bin/mkdir -p /var/lib/daedalus-patrol/home/.config
BindReadOnlyPaths=-/root/.config/opencode:/var/lib/daedalus-patrol/home/.config/opencode

# SMTP 凭据经凭据目录传递,内容可以为空(免密投递)。文件缺失时本单元拒绝启动 ——
# 凭据缺失要被看见,而不是悄悄换成匿名投递。
LoadCredential=smtp-username:/etc/credstore/smtp-username
LoadCredential=smtp-password:/etc/credstore/smtp-password

# 沙箱基线(与能力服务器同款)。不设 MemoryDenyWriteExecute:AI 客户端是 JIT 运行时,
# 禁止写可执行内存会让它起不来。
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

[Install]
WantedBy=multi-user.target
