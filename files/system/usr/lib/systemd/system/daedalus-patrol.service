[Unit]
Description=Daedalus 巡检(一轮,oneshot;只读)
After=network-online.target
Wants=network-online.target
# 不设 DynamicUser:巡检要读 fleet 客户端的 mTLS 私钥(仅 root 可读),并以 root 的
# 客户端配置取模型凭据。整条链路只做只读调用,不写任何节点状态。

[Service]
Type=oneshot
# 节点名由运维写进 /etc/daedalus/patrol.env(DAEDALUS_PATROL_NODE)。未配置时
# ${DAEDALUS_PATROL_NODE} 展开成空串,CLI 按用法错误退出 —— 宁可不跑,也不猜节点。
# fleet 凭证路径(DAEDALUS_FLEET_CLIENT_CERT / _KEY / _CA)同样写在这份 env 文件里;
# 证书权限决定这一轮能不能连上节点(见 files/system/etc/daedalus/patrol.toml 注释)。
EnvironmentFile=-/etc/daedalus/patrol.env
# AI 客户端必须装进 PATH 里的目录(镜像里没有 opencode;要自带客户端就在
# [patrol.ai_client].command 写绝对路径)。不写死 PATH 时 systemd 的默认值在
# 不同发行版上不一致,最坏的表现是「找不到 opencode」而不是配置错误。
# 注意:EnvironmentFile 里的同名变量会覆盖这里的值(与行序无关) —— 在 patrol.env
# 里另写 PATH 就等于接管这一行。
Environment=PATH=/root/.local/bin:/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/daedalus-patrol run --node ${DAEDALUS_PATROL_NODE}

# 轮次目录与跨轮状态都在这里;运行时给 AI 客户端一个可写的 HOME(它要写会话缓存)。
# 客户端会往 $HOME/.local/share/opencode 写日志与会话库,数据目录**必须可写** ——
# 整目录只读挂载会让客户端每轮都起不来(实测 PermissionDenied: makeDirectory
# .../opencode/log)。所以只挂配置目录(读),数据目录留给单元自己。
#
# daedalus 一并列出:fleet 根目录(/var/lib/daedalus/fleet)在 strict 沙箱里必须可写 ——
# SDK 的目录解析靠写哨兵文件判定可用,不可写会静默回退到 $HOME 下的空注册表,
# 现场表现为「所有节点都未注册」。
StateDirectory=daedalus-patrol daedalus
Environment=HOME=/var/lib/daedalus-patrol/home
# 客户端建的文件里可能有节点工具返回的原文(会话库、日志):umask 收紧到 0077,
# 让它们与轮次目录一样「同机不可读」。不给 StateDirectoryMode —— 同一个
# StateDirectory 里的 daedalus 目录要留给别的组件(1777 的子目录要能被遍历),
# 收紧父目录会把它们一起锁死。
UMask=0077
# 客户端的数据目录每轮重建:会话库与日志没有跨轮价值,留着只会无界增长
# (auth.json 每次都重新拷贝,旧副本也不会残留)。每轮重建也让「数据目录必须可写」
# 这件事收敛成本单元自己建的目录,不受上一次运行留下的状态影响。
# home 本身可能是 systemd 建 bind 目标点时顺手建的(0755,不受本单元 umask 影响):
# 显式收紧一次,别让别的本机用户能穿过它去读 .config/opencode（宿主的全局配置里
# 可能有内联 apiKey）。只 chmod home,不碰挂载点内部 —— 那会把模式改到宿主源目录上。
ExecStartPre=/bin/chmod 700 /var/lib/daedalus-patrol/home
ExecStartPre=/bin/rm -rf /var/lib/daedalus-patrol/home/.local/share/opencode
ExecStartPre=/bin/mkdir -p /var/lib/daedalus-patrol/home/.config /var/lib/daedalus-patrol/home/.local/share/opencode
# 全局配置只读挂载:客户端要读 model / provider / 插件清单,但不该改宿主的配置。
# 注意 provider 块里的内联 apiKey 会被 CLI 抄进轮次目录(轮次目录 0700,只保留最近
# 50 轮);不想留这份副本就把凭据放 auth.json,provider 只写 baseURL。
BindReadOnlyPaths=-/root/.config/opencode:/var/lib/daedalus-patrol/home/.config/opencode
# 凭据(auth.json)在宿主的数据目录里。整目录不能只读挂(见上),所以把凭据文件
# 复制进单元自己的可写数据目录。源文件不存在不算错(用内联 provider 凭据的部署
# 没有它);但源在而复制失败要报错 —— 那种情况必须被看见,不能降级成匿名投递。
ExecStartPre=/bin/sh -c 'if [ -f /root/.local/share/opencode/auth.json ]; then /bin/cp -f /root/.local/share/opencode/auth.json /var/lib/daedalus-patrol/home/.local/share/opencode/auth.json || exit 1; /bin/chmod 600 /var/lib/daedalus-patrol/home/.local/share/opencode/auth.json; fi' 

# SMTP 凭据经凭据目录传递,内容可以为空(免密投递)。文件缺失时本单元拒绝启动 ——
# 凭据缺失要被看见,而不是悄悄换成匿名投递。
LoadCredential=smtp-username:/etc/credstore/smtp-username
LoadCredential=smtp-password:/etc/credstore/smtp-password

# 一轮的最长寿命:必须大于 patrol.toml 里 node_timeout 的默认值(10m),否则正常轮次
# 会被 systemd 杀掉;又必须有界 —— oneshot 挂死会让单元一直 active,而 timer 的
# OnUnitActiveSec 从上次激活起算,卡住的单元会让后续轮次永远不触发。
# CLI 会拒绝大于 12m 的 node_timeout(留 3m 收尾),两处数值一起改。
TimeoutStartSec=15min
TimeoutStopSec=30s

# 沙箱基线(与能力服务器同款)。不设 MemoryDenyWriteExecute:AI 客户端是 JIT 运行时,
# 禁止写可执行内存会让它起不来。
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

[Install]
WantedBy=multi-user.target
