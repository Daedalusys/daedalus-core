{
  "id": "daedalus.avc",
  "name": "Daedalus SELinux AVC Denial Query",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-avc",
  "permissions": {
    "read": [
      "/var/log/audit",
      "/etc/selinux"
    ],
    "write": [],
    "run": [
      "/usr/sbin/ausearch",
      "/usr/bin/audit2why",
      "/usr/bin/audit2allow"
    ]
  },
  "tools": [
    "avc_recent",
    "avc_explain",
    "avc_summary"
  ],
  "i18n": [
    "en_US",
    "zh_CN"
  ],
