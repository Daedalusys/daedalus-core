{
  "id": "daedalus.service",
  "name": "Daedalus Service Query",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-service",
  "permissions": {
    "read": [
      "/etc/systemd",
      "/run/systemd",
      "/proc/1/cmdline"
    ],
    "write": [],
    "run": [
      "/usr/bin/systemctl"
    ]
  },
  "tools": [
    "service.query",
    "service.list",
    "systemd_failed",
    "systemd_timer_next",
    "systemd_dependencies"
  ],
  "resources": [
    {
      "kind": "service",
      "name": "*",
      "desired_state": ""
    }
  ],
