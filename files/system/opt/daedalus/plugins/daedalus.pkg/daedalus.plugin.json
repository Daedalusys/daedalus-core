{
  "id": "daedalus.pkg",
  "name": "Daedalus Package Query",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-pkg",
  "permissions": {
    "read": [
      "/var/lib/rpm",
      "/etc/yum.repos.d"
    ],
    "write": [],
    "run": [
      "/usr/bin/rpm",
      "/usr/bin/dnf"
    ]
  },
  "tools": [
    "dnf_query",
    "dnf_list_installed"
  ],
  "resources": [
    {
      "kind": "package",
      "name": "*",
      "desired_state": ""
    }
  ],
  "checksums": {
    "bin/daedalus-pkg": "sha256:1a254926220e7198878e301f9b55a847b48e3437ad5f70efbe3a1399e64f56c1",
