{
  "id": "daedalus.pkg",
  "name": "Daedalus Package Query",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-pkg",
  "permissions": {
    "read": [
      "/var/lib/rpm",
      "/etc/yum.repos.d"
    ],
    "write": [],
    "run": [
      "/usr/bin/rpm",
      "/usr/bin/dnf"
    ]
  },
  "tools": [
    "dnf_query",
    "dnf_list_installed"
  ],
  "resources": [
    {
      "kind": "package",
      "name": "*",
      "desired_state": ""
    }
  ],
  "checksums": {
    "bin/daedalus-pkg": "sha256:da1a34266f441d8cf83290d73614c71a828a05ab0041874dfb2792cd1cbf9032",
    "daedalus.plugin.json": "sha256:7b5f66d0e25a4ed551e574405d61ea50ca875ca9516155aafad9994f1c2fd115"
  },
  "api_version": "0.1.0",
