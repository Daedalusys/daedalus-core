{
  "id": "daedalus.triage",
  "name": "Daedalus Boot \u0026 Crash Triage",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-triage",
  "permissions": {
    "read": [
      "/var/lib/systemd/coredump",
      "/var/log/journal",
      "/run/log/journal"
    ],
    "write": [],
    "run": [
      "/usr/bin/systemd-analyze",
      "/usr/bin/coredumpctl",
      "/usr/bin/journalctl"
    ]
  },
  "tools": [
    "boot_blame",
    "boot_critical_chain",
    "last_boot_log",
    "coredumps_list",
    "coredump_info"
  ],
  "i18n": [
    "en_US",
    "zh_CN"
  ],
