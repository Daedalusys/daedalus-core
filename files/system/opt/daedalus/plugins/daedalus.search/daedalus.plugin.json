{
  "id": "daedalus.search",
  "name": "Daedalus File Search",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-search",
  "permissions": {
    "read": [
      "/run/user",
      "/var/run/user",
      "$XDG_RUNTIME_DIR"
    ],
    "write": [],
    "run": [
      "/usr/bin/baloosearch",
      "/usr/bin/baloosearch6",
      "/usr/bin/balooctl",
      "/usr/bin/balooctl6"
    ]
  },
  "tools": [
    "search_files",
    "search_content",
    "search_reindex"
  ],
  "i18n": [
    "en_US",
    "zh_CN"
  ],
