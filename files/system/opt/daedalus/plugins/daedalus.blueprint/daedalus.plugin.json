{
  "id": "daedalus.blueprint",
  "name": "Daedalus Blueprint",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-blueprint",
  "permissions": {
    "read": [
      "/etc/nginx/conf.d",
      "/etc/haproxy",
      "/etc/postgresql",
      "/etc/redis"
    ],
    "write": [
      "/etc/nginx/conf.d",
      "/etc/haproxy",
      "/etc/postgresql",
      "/etc/redis"
    ],
    "run": [
      "/usr/bin/nginx",
      "/usr/bin/haproxy",
      "/usr/bin/psql",
      "/usr/bin/redis-cli",
      "/usr/bin/systemctl"
    ]
  },
  "tools": [
    "blueprint_list",
    "blueprint_inspect",
    "blueprint_render",
    "blueprint_apply",
    "blueprint_status",
    "blueprint_remove"
  ],
  "checksums": {
    "bin/daedalus-blueprint": "sha256:a6d30daf82eced266ec77595c5fd58dfabad2fab38d3430b27c131c7435bf472",
    "daedalus.plugin.json": "sha256:a4f9e22e86cc8a35a4eb196177448198f77338931f9996b598e82117b438a707"
  },
  "api_version": "0.1.0",
  "license": "MIT",
  "maintainer": "team@daedalusys.io"
}
