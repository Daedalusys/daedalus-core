{
  "id": "daedalus.blueprint",
  "name": "Daedalus Blueprint",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-blueprint",
  "permissions": {
    "read": [
      "/etc/nginx/conf.d",
      "/etc/haproxy",
      "/etc/postgresql",
      "/etc/redis"
    ],
    "write": [
      "/etc/nginx/conf.d",
      "/etc/haproxy",
      "/etc/postgresql",
      "/etc/redis"
    ],
    "run": [
      "/usr/bin/nginx",
      "/usr/bin/haproxy",
      "/usr/bin/psql",
      "/usr/bin/redis-cli",
      "/usr/bin/systemctl"
    ]
  },
  "tools": [
    "blueprint_list",
    "blueprint_inspect",
    "blueprint_render",
    "blueprint_apply",
    "blueprint_status",
    "blueprint_remove"
  ],
  "checksums": {
    "bin/daedalus-blueprint": "sha256:09989dd7f45be68c13721c236de55e6b19c1023f505b7c01e8d3ab799b5d725c",
