{
  "id": "daedalus.diskclean",
  "name": "Daedalus Disk Cleanup (Cache / Journal / Coredump / Old Kernel)",
  "version": "0.1.0",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-diskclean",
  "permissions": {
    "read": [
      "/var/log/journal",
      "/var/cache/dnf",
      "/var/cache/PackageKit",
      "/var/lib/systemd/coredump",
      "/var/tmp",
      "/home",
      "/proc",
      "/var/log"
    ],
    "write": [
      "/var/log/journal",
      "/var/cache/dnf",
      "/var/cache/PackageKit",
      "/var/lib/systemd/coredump",
      "/var/tmp",
      "/home"
    ],
    "run": null
  },
  "tools": [
    "disk_scan",
    "disk_estimate",
    "disk_explain",
    "disk_clean"
  ],
  "i18n": [
    "en_US",
    "zh_CN"
  ],
  "checksums": {
    "bin/daedalus-diskclean": "sha256:bb661fc951d3a2cd3c85316364472e82aebd62282d7757badbedbc0e5e114e8c",
