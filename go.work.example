go 1.25.0

use (
	.
	../daedalus-plugins/blueprint
	../daedalus-plugins/dupe
	../daedalus-plugins/fs
	../daedalus-plugins/pkg
	../daedalus-plugins/service
	../daedalus-plugins/shell
	../daedalus-plugins/sysinfo
	../daedalus-plugins/trace
	../daedalus-sdk
)

// 三仓平级 dev 桥:各 cap 的 go.mod 里 `replace ... => ../daedalus-sdk` 是为
// 插件仓 CI 写的(GitHub Actions 不允许 checkout 逃出 GITHUB_WORKSPACE,SDK 只能
// 检出到 daedalus-plugins/daedalus-sdk),本地平级布局下该路径不存在,且与下面
// `use ../daedalus-sdk` 冲突 -> "conflicting replacements"。workspace 级 replace
// 覆盖模块级,按两个 require 版本(v0.0.0 与零伪版本)各钉一行即可,无需动 go.mod。
replace github.com/Daedalusys/daedalus-sdk v0.0.0 => ../daedalus-sdk
replace github.com/Daedalusys/daedalus-sdk v0.0.0-00010101000000-000000000000 => ../daedalus-sdk
